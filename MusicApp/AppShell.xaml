<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MusicApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MusicApp"
    xmlns:Views="clr-namespace:MusicApp.Views"
    Title="MusicApp">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate Views:WelcomeScreen}"
        Route="MainPage" />
    <ShellContent
    Title="Home"
    ContentTemplate="{DataTemplate Views:PhoneNumberPage}"
    Route="PhoneNumberPage" />
    <ShellContent
    Title="Home"
    ContentTemplate="{DataTemplate Views:OtpPage}"
    Route="OtpPage" />
    
</Shell>
