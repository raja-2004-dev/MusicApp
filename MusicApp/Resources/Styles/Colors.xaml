<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Backgrounds -->
    <Color x:Key="BackgroundColor">#121212</Color>
    <Color x:Key="SurfaceColor">#1C1C1E</Color>
    <Color x:Key="CardColor">#252525</Color>

    <!-- Primary Brand -->
    <Color x:Key="PrimaryColor">#FF7A00</Color>
    <Color x:Key="PrimaryDarkColor">#E56700</Color>
    <Color x:Key="PrimaryLightColor">#FFA64D</Color>

    <!-- Secondary -->
    <Color x:Key="SecondaryColor">#00D4B5</Color>

    <!-- Text -->
    <Color x:Key="PrimaryTextColor">#FFFFFF</Color>
    <Color x:Key="SecondaryTextColor">#B3B3B3</Color>
    <Color x:Key="HintTextColor">#7A7A7A</Color>

    <!-- Icons -->
    <Color x:Key="IconColor">#E5E5E5</Color>
    <Color x:Key="IconInactiveColor">#7C7C7C</Color>

    <!-- Borders -->
    <Color x:Key="BorderColor">#353535</Color>

    <!-- Status -->
    <Color x:Key="SuccessColor">#4CAF50</Color>
    <Color x:Key="WarningColor">#FFC107</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>

    <!-- Player -->
    <Color x:Key="ProgressBackgroundColor">#3A3A3A</Color>
    <Color x:Key="ProgressColor">#FF7A00</Color>

</ResourceDictionary>