<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MusicApp.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="Home"
    BackgroundColor="#121212"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <!-- Main Content -->

        <ScrollView Grid.Row="0">

            <VerticalStackLayout
                Padding="20,45,20,20"
                Spacing="25">

                <!-- Header -->

                <Grid ColumnDefinitions="*,Auto,Auto">

                    <VerticalStackLayout
                        VerticalOptions="Center">

                        <Label
                            Text="Good Morning 👋"
                            FontSize="15"
                            TextColor="#AAAAAA"/>

                        <Label
                            Text="Listen to your music"
                            FontSize="26"
                            FontAttributes="Bold"
                            TextColor="White"/>

                    </VerticalStackLayout>


                    <!-- Search -->

                    <Border
                        Grid.Column="1"
                        Margin="0,0,10,0"
                        WidthRequest="45"
                        HeightRequest="45"
                        BackgroundColor="#1E1E1E"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22">

                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Command="{Binding OpenSearchCommand}"/>

                        </Border.GestureRecognizers>

                        <Image
                            Source="search.png"
                            WidthRequest="21"
                            HeightRequest="21"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">

                            <Image.Behaviors>

                                <toolkit:IconTintColorBehavior
                                    TintColor="White"/>

                            </Image.Behaviors>

                        </Image>

                    </Border>


                    <!-- Profile -->

                    <Border
                        Grid.Column="2"
                        WidthRequest="45"
                        HeightRequest="45"
                        BackgroundColor="#E56700"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22">

                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Command="{Binding OpenProfileCommand}"/>

                        </Border.GestureRecognizers>

                        <Image
                            Source="profile.png"
                            WidthRequest="22"
                            HeightRequest="22"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">

                            <Image.Behaviors>

                                <toolkit:IconTintColorBehavior
                                    TintColor="White"/>

                            </Image.Behaviors>

                        </Image>

                    </Border>

                </Grid>


                <!-- Recently Played -->

                <Grid ColumnDefinitions="*,Auto">

                    <Label
                        Text="Recently Played"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="White"/>

                </Grid>


                <CollectionView
                    ItemsSource="{Binding RecentlyPlayed}"
                    SelectionMode="None"
                    HeightRequest="100">

                    <CollectionView.EmptyView>

                        <Label
                            Text="No recently played songs"
                            TextColor="#777777"
                            FontSize="14"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>

                    </CollectionView.EmptyView>


                    <CollectionView.ItemsLayout>

                        <LinearItemsLayout
                            Orientation="Horizontal"
                            ItemSpacing="12"/>

                    </CollectionView.ItemsLayout>


                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Border
                                WidthRequest="260"
                                Padding="10"
                                BackgroundColor="#1E1E1E"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 15">

                                <Grid
                                    ColumnDefinitions="65,*,Auto"
                                    ColumnSpacing="10">

                                    <Image
                                        Source="{Binding Image}"
                                        WidthRequest="65"
                                        HeightRequest="65"
                                        Aspect="AspectFill"/>


                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding Title}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="White"
                                            LineBreakMode="TailTruncation"/>

                                        <Label
                                            Text="{Binding Artist}"
                                            FontSize="13"
                                            TextColor="#AAAAAA"
                                            LineBreakMode="TailTruncation"/>

                                    </VerticalStackLayout>


                                    <Border
                                        Grid.Column="2"
                                        WidthRequest="38"
                                        HeightRequest="38"
                                        BackgroundColor="#E56700"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 19"
                                        VerticalOptions="Center">

                                        <Border.GestureRecognizers>

                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                    Path=BindingContext.PlaySongCommand}"
                                                CommandParameter="{Binding .}"/>

                                        </Border.GestureRecognizers>

                                        <Image
                                            Source="play.png"
                                            WidthRequest="17"
                                            HeightRequest="17"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">

                                            <Image.Behaviors>

                                                <toolkit:IconTintColorBehavior
                                                    TintColor="White"/>

                                            </Image.Behaviors>

                                        </Image>

                                    </Border>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>


                <!-- Trending -->

                <Grid ColumnDefinitions="*,Auto">

                    <Label
                        Text="Trending Songs"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="White"/>

                </Grid>


                <CollectionView
                    ItemsSource="{Binding TrendingSongs}"
                    SelectionMode="None"
                    HeightRequest="245">

                    <CollectionView.ItemsLayout>

                        <LinearItemsLayout
                            Orientation="Horizontal"
                            ItemSpacing="15"/>

                    </CollectionView.ItemsLayout>


                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Border
                                WidthRequest="160"
                                Padding="12"
                                BackgroundColor="#1E1E1E"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18">

                                <VerticalStackLayout
                                    Spacing="8">

                                    <Grid>

                                        <Image
                                            Source="{Binding Image}"
                                            WidthRequest="136"
                                            HeightRequest="136"
                                            Aspect="AspectFill"/>

                                        <Border
                                            WidthRequest="42"
                                            HeightRequest="42"
                                            BackgroundColor="#E56700"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 21"
                                            HorizontalOptions="End"
                                            VerticalOptions="End"
                                            Margin="0,0,8,8">

                                            <Border.GestureRecognizers>

                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                        Path=BindingContext.PlaySongCommand}"
                                                    CommandParameter="{Binding .}"/>

                                            </Border.GestureRecognizers>

                                            <Image
                                                Source="play.png"
                                                WidthRequest="18"
                                                HeightRequest="18"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">

                                                <Image.Behaviors>

                                                    <toolkit:IconTintColorBehavior
                                                        TintColor="White"/>

                                                </Image.Behaviors>

                                            </Image>

                                        </Border>

                                    </Grid>


                                    <Label
                                        Text="{Binding Title}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="White"
                                        LineBreakMode="TailTruncation"/>

                                    <Label
                                        Text="{Binding Artist}"
                                        FontSize="13"
                                        TextColor="#AAAAAA"
                                        LineBreakMode="TailTruncation"/>

                                </VerticalStackLayout>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>


                <!-- Recommended -->

                <Label
                    Text="Recommended For You"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="White"/>


                <CollectionView
                    ItemsSource="{Binding RecommendedSongs}"
                    SelectionMode="None"
                    HeightRequest="350">

                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Margin="0,0,0,12"
                                Padding="12"
                                BackgroundColor="#1E1E1E"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18">

                                <Grid
                                    ColumnDefinitions="65,*,Auto"
                                    ColumnSpacing="15">

                                    <Image
                                        Source="{Binding Image}"
                                        WidthRequest="65"
                                        HeightRequest="65"
                                        Aspect="AspectFill"/>


                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding Title}"
                                            FontSize="17"
                                            FontAttributes="Bold"
                                            TextColor="White"/>

                                        <Label
                                            Text="{Binding Artist}"
                                            FontSize="14"
                                            TextColor="#AAAAAA"/>

                                        <Label
                                            Text="{Binding Duration}"
                                            FontSize="12"
                                            TextColor="#777777"/>

                                    </VerticalStackLayout>


                                    <Border
                                        Grid.Column="2"
                                        WidthRequest="45"
                                        HeightRequest="45"
                                        BackgroundColor="#E56700"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 22"
                                        VerticalOptions="Center">

                                        <Border.GestureRecognizers>

                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                    Path=BindingContext.PlaySongCommand}"
                                                CommandParameter="{Binding .}"/>

                                        </Border.GestureRecognizers>

                                        <Image
                                            Source="play.png"
                                            WidthRequest="19"
                                            HeightRequest="19"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">

                                            <Image.Behaviors>

                                                <toolkit:IconTintColorBehavior
                                                    TintColor="White"/>

                                            </Image.Behaviors>

                                        </Image>

                                    </Border>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

        </ScrollView>


        <!-- Bottom Navigation -->

        <Border
            Grid.Row="1"
            Margin="15,5,15,15"
            Padding="10,8"
            BackgroundColor="#1E1E1E"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 25">

            <Grid ColumnDefinitions="*,*,*,*">

                <!-- Home -->

                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="3"
                    HorizontalOptions="Center">

                    <Image
                        Source="home.png"
                        WidthRequest="22"
                        HeightRequest="22">

                        <Image.Behaviors>

                            <toolkit:IconTintColorBehavior
                                TintColor="#E56700"/>

                        </Image.Behaviors>

                    </Image>

                    <Label
                        Text="Home"
                        FontSize="11"
                        TextColor="#E56700"/>

                </VerticalStackLayout>


                <!-- Search -->

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="3"
                    HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>

                        <TapGestureRecognizer
                            Command="{Binding OpenSearchCommand}"/>

                    </VerticalStackLayout.GestureRecognizers>

                    <Image
                        Source="search.png"
                        WidthRequest="22"
                        HeightRequest="22">

                        <Image.Behaviors>

                            <toolkit:IconTintColorBehavior
                                TintColor="White"/>

                        </Image.Behaviors>

                    </Image>

                    <Label
                        Text="Search"
                        FontSize="11"
                        TextColor="#AAAAAA"/>

                </VerticalStackLayout>


                <!-- Library -->

                <VerticalStackLayout
                    Grid.Column="2"
                    Spacing="3"
                    HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>

                        <TapGestureRecognizer
                            Command="{Binding OpenLibraryCommand}"/>

                    </VerticalStackLayout.GestureRecognizers>

                    <Image
                        Source="library.png"
                        WidthRequest="22"
                        HeightRequest="22">

                        <Image.Behaviors>

                            <toolkit:IconTintColorBehavior
                                TintColor="White"/>

                        </Image.Behaviors>

                    </Image>

                    <Label
                        Text="Library"
                        FontSize="11"
                        TextColor="#AAAAAA"/>

                </VerticalStackLayout>


                <!-- Profile -->

                <VerticalStackLayout
                    Grid.Column="3"
                    Spacing="3"
                    HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>

                        <TapGestureRecognizer
                            Command="{Binding OpenProfileCommand}"/>

                    </VerticalStackLayout.GestureRecognizers>

                    <Image
                        Source="profile.png"
                        WidthRequest="22"
                        HeightRequest="22">

                        <Image.Behaviors>

                            <toolkit:IconTintColorBehavior
                                TintColor="White"/>

                        </Image.Behaviors>

                    </Image>

                    <Label
                        Text="Profile"
                        FontSize="11"
                        TextColor="#AAAAAA"/>

                </VerticalStackLayout>

            </Grid>

        </Border>

    </Grid>

</ContentPage>