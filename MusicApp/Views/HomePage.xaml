<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MusicApp.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="HomePage"
    Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="*,Auto">

        <!--  Main Content  -->
        <ScrollView Grid.Row="0">

            <VerticalStackLayout Padding="20,50,20,20" Spacing="25">

                <!--  Header  -->
                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout Spacing="5">

                        <Label
                            FontAttributes="Bold"
                            FontSize="28"
                            Text="Good Morning 👋"
                            TextColor="White" />

                        <Label
                            FontSize="14"
                            Text="Enjoy your favourite music"
                            TextColor="#AAAAAA" />

                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        BackgroundColor="#1E1E1E"
                        HeightRequest="50"
                        StrokeShape="RoundRectangle 25"
                        StrokeThickness="0"
                        WidthRequest="50">

                        <Image
                            HeightRequest="35"
                            HorizontalOptions="Center"
                            Source="profile.png"
                            VerticalOptions="Center"
                            WidthRequest="35" />

                    </Border>

                </Grid>

                <!--  Search  -->
                <Border
                    BackgroundColor="#1E1E1E"
                    HeightRequest="55"
                    StrokeShape="RoundRectangle 15"
                    StrokeThickness="0">

                    <Grid
                        Padding="15,0"
                        ColumnDefinitions="Auto,*"
                        VerticalOptions="Center">

                        <Image
                            HeightRequest="20"
                            Source="search.png"
                            VerticalOptions="Center"
                            WidthRequest="20">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="White" />
                            </Image.Behaviors>
                        </Image>

                        <Entry
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            BackgroundColor="Transparent"
                            FontSize="16"
                            Placeholder="Search songs, artists..."
                            PlaceholderColor="#777777"
                            Text="{Binding SearchText}"
                            TextColor="White" />

                    </Grid>

                </Border>

                <!--  Recently Played  -->
                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    Text="Recently Played"
                    TextColor="White" />

                <!--  Part 2  -->
                <CollectionView
                    HeightRequest="220"
                    ItemsLayout="HorizontalList"
                    ItemsSource="{Binding RecentlyPlayed}">

                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Margin="0,0,15,0"
                                BackgroundColor="#1E1E1E"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="0"
                                WidthRequest="170">

                                <VerticalStackLayout Padding="15">

                                    <Image
                                        Aspect="AspectFill"
                                        HeightRequest="130"
                                        Source="{Binding Image}">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="White" />
                                        </Image.Behaviors>
                                    </Image>

                                    <Label
                                        Margin="0,10,0,0"
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        Text="{Binding Title}"
                                        TextColor="White" />

                                    <Label
                                        FontSize="14"
                                        Text="{Binding Artist}"
                                        TextColor="#A0A0A0" />

                                    <Label
                                        FontSize="12"
                                        Text="{Binding Duration}"
                                        TextColor="#E56700" />

                                </VerticalStackLayout>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

                <!--  Recommended  -->
                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    Text="Recommended For You"
                    TextColor="White" />

                <!--  Part 2  -->
                <CollectionView
                    HeightRequest="230"
                    ItemsLayout="HorizontalList"
                    ItemsSource="{Binding RecommendedSongs}">

                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Margin="0,0,15,0"
                                BackgroundColor="#1E1E1E"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="0"
                                WidthRequest="180">

                                <VerticalStackLayout Padding="15">

                                    <Image
                                        Aspect="AspectFill"
                                        HeightRequest="140"
                                        Source="{Binding Image}">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="White" />
                                        </Image.Behaviors>
                                    </Image>

                                    <Label
                                        Margin="0,10,0,0"
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        Text="{Binding Title}"
                                        TextColor="White" />

                                    <Label
                                        FontSize="14"
                                        Text="{Binding Artist}"
                                        TextColor="#AAAAAA" />

                                    <Button
                                        Margin="0,10,0,0"
                                        BackgroundColor="#E56700"
                                        CornerRadius="18"
                                        HeightRequest="38"
                                        Text="Play"
                                        TextColor="White" />

                                </VerticalStackLayout>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

                <!--  Trending  -->
                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    Text="Trending Songs"
                    TextColor="White" />

                <!--  Part 3  -->
                <CollectionView
                    HeightRequest="380"
                    ItemsSource="{Binding TrendingSongs}"
                    SelectionMode="None">

                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Margin="0,0,0,12"
                                Padding="12"
                                BackgroundColor="#1E1E1E"
                                StrokeShape="RoundRectangle 18"
                                StrokeThickness="0">

                                <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="15">

                                    <!--  Album  -->

                                    <Image
                                        Grid.Column="0"
                                        Aspect="AspectFill"
                                        HeightRequest="70"
                                        Source="{Binding Image}"
                                        WidthRequest="70">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="White" />
                                        </Image.Behaviors>
                                    </Image>

                                    <!--  Song  -->

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">

                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="18"
                                            Text="{Binding Title}"
                                            TextColor="White" />

                                        <Label
                                            FontSize="14"
                                            Text="{Binding Artist}"
                                            TextColor="#AAAAAA" />

                                        <Label
                                            FontSize="12"
                                            Text="{Binding Duration}"
                                            TextColor="#E56700" />

                                    </VerticalStackLayout>

                                    <!--  Play Button  -->

                                    <Border
                                        Grid.Column="2"
                                        BackgroundColor="#E56700"
                                        HeightRequest="45"
                                        StrokeShape="RoundRectangle 22"
                                        StrokeThickness="0"
                                        VerticalOptions="Center"
                                        WidthRequest="45">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.PlaySongCommand}" CommandParameter="{Binding}" />
                                        </Border.GestureRecognizers>

                                        <Image
                                            HeightRequest="18"
                                            HorizontalOptions="Center"
                                            Source="play.png"
                                            VerticalOptions="Center"
                                            WidthRequest="18">
                                            <Image.Behaviors>
                                                <toolkit:IconTintColorBehavior TintColor="White" />
                                            </Image.Behaviors>
                                        </Image>

                                    </Border>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

        </ScrollView>

        <!--  Bottom Navigation  -->
        <Border
            Grid.Row="1"
            BackgroundColor="#1A1A1A"
            HeightRequest="75"
            StrokeThickness="0">

            <Grid Padding="20,0" ColumnDefinitions="*,*,*,*">

                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">

                    <Image
                        HeightRequest="24"
                        Source="home.png"
                        WidthRequest="24">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="White" />
                        </Image.Behaviors>
                    </Image>

                    <Label
                        FontSize="12"
                        Text="Home"
                        TextColor="#E56700" />

                </VerticalStackLayout>

                <VerticalStackLayout
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSearchCommand}" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Image
                        HeightRequest="24"
                        Source="search.png"
                        WidthRequest="24">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="White" />
                        </Image.Behaviors>
                    </Image>

                    <Label Text="Search" TextColor="White" />
                </VerticalStackLayout>

                <VerticalStackLayout
                    Grid.Column="2"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenLibraryCommand}" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Image
                        HeightRequest="24"
                        Source="library.png"
                        WidthRequest="24">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="White" />
                        </Image.Behaviors>
                    </Image>

                    <Label
                        FontSize="12"
                        Text="Library"
                        TextColor="White" />

                </VerticalStackLayout>

                <VerticalStackLayout
                    Grid.Column="3"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenProfileCommand}" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Image
                        HeightRequest="24"
                        Source="user.png"
                        WidthRequest="24">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="White" />
                        </Image.Behaviors>
                    </Image>

                    <Label
                        FontSize="12"
                        Text="Profile"
                        TextColor="White" />

                </VerticalStackLayout>

            </Grid>

        </Border>

    </Grid>
</ContentPage>