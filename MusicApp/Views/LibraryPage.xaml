<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MusicApp.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="LibraryPage">
    <ScrollView>

        <VerticalStackLayout Padding="20,50,20,20" Spacing="20">

            <!--  Header  -->

            <Grid ColumnDefinitions="Auto,*">

                <Border
                    BackgroundColor="#1E1E1E"
                    HeightRequest="45"
                    StrokeShape="RoundRectangle 22"
                    StrokeThickness="0"
                    WidthRequest="45">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Border.GestureRecognizers>

                    <Image
                        HeightRequest="22"
                        HorizontalOptions="Center"
                        Source="back.png"
                        VerticalOptions="Center"
                        WidthRequest="22" />

                </Border>

                <Label
                    Grid.Column="1"
                    Margin="15,0"
                    FontAttributes="Bold"
                    FontSize="28"
                    Text="Library"
                    TextColor="White"
                    VerticalOptions="Center" />

            </Grid>

            <Label
                FontSize="18"
                Text="Your Music"
                TextColor="#AAAAAA" />

            <!--  Favorites  -->

            <Border
                Padding="18"
                BackgroundColor="#1E1E1E"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="0">

                <Grid ColumnDefinitions="Auto,*,Auto">

                    <Label FontSize="18" Text="❤️" />

                    <Label
                        Grid.Column="1"
                        Margin="10,0"
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="Favorites"
                        TextColor="White" />

                    <Label
                        Grid.Column="2"
                        Text="120"
                        TextColor="#E56700" />

                </Grid>

            </Border>

            <!--  Playlist  -->

            <Border
                Padding="18"
                BackgroundColor="#1E1E1E"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="0">

                <Grid ColumnDefinitions="Auto,*,Auto">

                    <Label FontSize="18" Text="🎼" />

                    <Label
                        Grid.Column="1"
                        Margin="10,0"
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="Playlists"
                        TextColor="White" />

                    <Label
                        Grid.Column="2"
                        Text="12"
                        TextColor="#E56700" />

                </Grid>

            </Border>

            <!--  Downloads  -->

            <Border
                Padding="18"
                BackgroundColor="#1E1E1E"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="0">

                <Grid ColumnDefinitions="Auto,*,Auto">

                    <Label FontSize="18" Text="⬇" />

                    <Label
                        Grid.Column="1"
                        Margin="10,0"
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="Downloads"
                        TextColor="White" />

                    <Label
                        Grid.Column="2"
                        Text="18"
                        TextColor="#E56700" />

                </Grid>

            </Border>

            <!--  Recently Played  -->

            <Label
                FontAttributes="Bold"
                FontSize="22"
                Text="Recently Played"
                TextColor="White" />

            <CollectionView ItemsSource="{Binding FavoriteSongs}" SelectionMode="None">

                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        Padding="30"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Label
                            FontSize="60"
                            HorizontalOptions="Center"
                            Text="❤️" />

                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            HorizontalOptions="Center"
                            Text="No favorite songs yet"
                            TextColor="White" />

                        <Label
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="Tap the heart icon on a song to add it here."
                            TextColor="#AAAAAA" />

                    </VerticalStackLayout>

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="0,0,0,12"
                            Padding="12"
                            BackgroundColor="#1E1E1E"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="0">

                            <Grid ColumnDefinitions="60,*,Auto">

                                <Image
                                    HeightRequest="60"
                                    Source="{Binding Image}"
                                    WidthRequest="60" />

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Margin="15,0"
                                    VerticalOptions="Center">

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        Text="{Binding Title}"
                                        TextColor="White" />

                                    <Label
                                        FontSize="14"
                                        Text="{Binding Artist}"
                                        TextColor="#AAAAAA" />

                                </VerticalStackLayout>

                                <Image
                                    Grid.Column="2"
                                    HeightRequest="24"
                                    Source="play.png"
                                    VerticalOptions="Center"
                                    WidthRequest="24" />

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>
</ContentPage>