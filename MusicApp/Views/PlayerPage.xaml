<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MusicApp.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    BackgroundColor="#121212"
    Shell.NavBarIsVisible="False">

    <Grid Padding="20,50,20,20" RowDefinitions="Auto,*,Auto">

        <!--  Header  -->

        <Grid Grid.Row="0" ColumnDefinitions="50,*,50">

            <!--  Back  -->

            <Border
                BackgroundColor="#1E1E1E"
                HeightRequest="45"
                StrokeShape="RoundRectangle 22"
                StrokeThickness="0"
                WidthRequest="45">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>

                <Image
                    HeightRequest="22"
                    HorizontalOptions="Center"
                    Source="back.png"
                    VerticalOptions="Center"
                    WidthRequest="22">

                    <Image.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="White" />
                    </Image.Behaviors>

                </Image>

            </Border>

            <!--  Title  -->

            <VerticalStackLayout
                Grid.Column="1"
                HorizontalOptions="Center"
                Spacing="0"
                VerticalOptions="Center">

                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    Text="Now Playing"
                    TextColor="White" />

                <Label
                    FontSize="12"
                    Text="Music 2.0"
                    TextColor="#AAAAAA" />

            </VerticalStackLayout>

            <!--  More  -->

            <Border
                Grid.Column="2"
                BackgroundColor="#1E1E1E"
                HeightRequest="45"
                StrokeShape="RoundRectangle 22"
                StrokeThickness="0"
                WidthRequest="45">

                <Image
                    HeightRequest="22"
                    HorizontalOptions="Center"
                    Source="more.png"
                    VerticalOptions="Center"
                    WidthRequest="22">

                    <Image.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="White" />
                    </Image.Behaviors>

                </Image>

            </Border>

        </Grid>

        <!--  Main Content  -->

        <VerticalStackLayout
            Grid.Row="1"
            Spacing="25"
            VerticalOptions="Center">

            <!--  Album  -->

            <Border
                HeightRequest="260"
                HorizontalOptions="Center"
                StrokeShape="RoundRectangle 25"
                StrokeThickness="0"
                WidthRequest="260">

                <Image Aspect="AspectFill" Source="{Binding Image}" />

            </Border>

            <!--  Song  -->

            <VerticalStackLayout HorizontalOptions="Center" Spacing="5">

                <Label
                    FontAttributes="Bold"
                    FontSize="30"
                    HorizontalOptions="Center"
                    Text="{Binding Title}"
                    TextColor="White" />

                <Label
                    FontSize="18"
                    HorizontalOptions="Center"
                    Text="{Binding Artist}"
                    TextColor="#A5A5A5" />

            </VerticalStackLayout>

            <!--  Progress  -->

            <Slider
    x:Name="ProgressSlider"
    Minimum="0"
    Maximum="{Binding Duration}"
    Value="{Binding Progress, Mode=OneWay}"
    MinimumTrackColor="#E56700"
    MaximumTrackColor="#444444"
    ThumbColor="#E56700"
    DragCompleted="ProgressSlider_DragCompleted" />
            <!--  Time  -->

            <Grid ColumnDefinitions="Auto,*,Auto">

                <Label Text="{Binding CurrentTime}" TextColor="#A5A5A5" />

                <Label
                    Grid.Column="2"
                    Text="{Binding TotalTime}"
                    TextColor="#A5A5A5" />

            </Grid>

            <!--  Controls  -->

            <Grid Margin="0,15" ColumnDefinitions="*,*,*,*,*">

                <!--  Shuffle  -->

                <Image
    Source="{Binding ShuffleIcon}"
    HeightRequest="24"
    WidthRequest="24">

                    <Image.GestureRecognizers>
                        <TapGestureRecognizer
            Command="{Binding ToggleShuffleCommand}" />
                    </Image.GestureRecognizers>

                </Image>

                <!--  Previous  -->

                <Border
                    Grid.Column="1"
                    BackgroundColor="#1E1E1E"
                    HeightRequest="55"
                    StrokeShape="RoundRectangle 28"
                    StrokeThickness="0"
                    WidthRequest="55">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PreviousSongCommand}" />
                    </Border.GestureRecognizers>

                    <Image
                        HeightRequest="24"
                        HorizontalOptions="Center"
                        Source="previous.png"
                        VerticalOptions="Center"
                        WidthRequest="24">

                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="White" />
                        </Image.Behaviors>

                    </Image>

                </Border>

                <!--  Play  -->

                <Border
                    Grid.Column="2"
                    BackgroundColor="#E56700"
                    HeightRequest="75"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 38"
                    StrokeThickness="0"
                    WidthRequest="75">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PlayPauseCommand}" />
                    </Border.GestureRecognizers>

                    <Image
                        HeightRequest="34"
                        HorizontalOptions="Center"
                        Source="{Binding PlayPauseIcon}"
                        VerticalOptions="Center"
                        WidthRequest="34">

                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="White" />
                        </Image.Behaviors>

                    </Image>

                </Border>

                <!--  Next  -->

                <Border
                    Grid.Column="3"
                    BackgroundColor="#1E1E1E"
                    HeightRequest="55"
                    StrokeShape="RoundRectangle 28"
                    StrokeThickness="0"
                    WidthRequest="55">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NextSongCommand}" />
                    </Border.GestureRecognizers>

                    <Image
                        HeightRequest="24"
                        HorizontalOptions="Center"
                        Source="next.png"
                        VerticalOptions="Center"
                        WidthRequest="24">

                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="White" />
                        </Image.Behaviors>

                    </Image>

                </Border>

                <!--  Repeat  -->

                <Image
    Source="{Binding RepeatIcon}"
    HeightRequest="24"
    WidthRequest="24">

                    <Image.GestureRecognizers>
                        <TapGestureRecognizer
            Command="{Binding ToggleRepeatCommand}" />
                    </Image.GestureRecognizers>

                </Image>

            </Grid>

        </VerticalStackLayout>
        <!--  Bottom Buttons  -->

        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,*"
            ColumnSpacing="15">

            <!--  Favorite  -->

            <Border
                Grid.Column="0"
                Padding="15"
                BackgroundColor="#1E1E1E"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="0">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleFavoriteCommand}" />
                </Border.GestureRecognizers>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">

                    <Image
                        HeightRequest="22"
                        Source="{Binding FavoriteIcon}"
                        WidthRequest="22">

                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="White" />
                        </Image.Behaviors>

                    </Image>

                    <Label
                        FontSize="16"
                        Text="Favorite"
                        TextColor="White"
                        VerticalOptions="Center" />

                </HorizontalStackLayout>

            </Border>

            <!--  Lyrics  -->

            <Border
                Grid.Column="1"
                Padding="15"
                BackgroundColor="#E56700"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="0">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding LyricsCommand}" />
                </Border.GestureRecognizers>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">

                    <Label FontSize="20" Text="📄" />

                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Lyrics"
                        TextColor="White"
                        VerticalOptions="Center" />

                </HorizontalStackLayout>

            </Border>

        </Grid>

    </Grid>

</ContentPage>