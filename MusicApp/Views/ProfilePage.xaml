<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MusicApp.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="ProfilePage">
    <ScrollView>

        <VerticalStackLayout Padding="20,50,20,20" Spacing="25">

            <!--  Header  -->

            <Grid ColumnDefinitions="Auto,*">

                <Border
                    BackgroundColor="#1E1E1E"
                    HeightRequest="45"
                    StrokeShape="RoundRectangle 22"
                    StrokeThickness="0"
                    WidthRequest="45">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Border.GestureRecognizers>

                    <Image
                        HeightRequest="22"
                        HorizontalOptions="Center"
                        Source="back.png"
                        VerticalOptions="Center"
                        WidthRequest="22" />

                </Border>

                <Label
                    Grid.Column="1"
                    Margin="15,0"
                    FontAttributes="Bold"
                    FontSize="28"
                    Text="Profile"
                    TextColor="White"
                    VerticalOptions="Center" />

            </Grid>

            <!--  Profile  -->

            <VerticalStackLayout HorizontalOptions="Center" Spacing="12">

                <Border
                    BackgroundColor="#1E1E1E"
                    HeightRequest="120"
                    StrokeShape="RoundRectangle 60"
                    StrokeThickness="0"
                    WidthRequest="120">

                    <Image
                        HeightRequest="80"
                        HorizontalOptions="Center"
                        Source="profile.png"
                        VerticalOptions="Center"
                        WidthRequest="80" />

                </Border>

                <Label
                    FontAttributes="Bold"
                    FontSize="24"
                    Text="{Binding UserName}"
                    TextColor="White" />

                <Label
                    FontSize="15"
                    Text="{Binding Email}"
                    TextColor="#AAAAAA" />

            </VerticalStackLayout>

            <!--  Menu  -->

            <CollectionView ItemsSource="{Binding MenuItems}" SelectionMode="None">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="0,0,0,12"
                            Padding="15"
                            BackgroundColor="#1E1E1E"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="0">

                            <Grid ColumnDefinitions="40,*,Auto">

                                <Label
                                    FontSize="22"
                                    Text="{Binding Icon}"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    Margin="10,0"
                                    FontSize="17"
                                    Text="{Binding Title}"
                                    TextColor="White"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="2"
                                    FontSize="20"
                                    Text="&gt;"
                                    TextColor="#888888"
                                    VerticalOptions="Center" />

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <Button
                BackgroundColor="#E56700"
                CornerRadius="18"
                FontAttributes="Bold"
                HeightRequest="55"
                Text="Logout"
                TextColor="White" />

        </VerticalStackLayout>

    </ScrollView>
</ContentPage>