<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MusicApp.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Search">

    <ScrollView>

        <VerticalStackLayout Padding="20,50,20,20" Spacing="20">

            <!--  Header  -->

            <Grid ColumnDefinitions="Auto,*">

                <Border
                    BackgroundColor="#1E1E1E"
                    HeightRequest="45"
                    StrokeShape="RoundRectangle 22"
                    StrokeThickness="0"
                    WidthRequest="45">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Border.GestureRecognizers>

                    <Image
                        HeightRequest="22"
                        HorizontalOptions="Center"
                        Source="back.png"
                        VerticalOptions="Center"
                        WidthRequest="22" />

                </Border>

                <Label
                    Grid.Column="1"
                    Margin="15,0,0,0"
                    FontAttributes="Bold"
                    FontSize="28"
                    Text="Search"
                    TextColor="White"
                    VerticalOptions="Center" />

            </Grid>

            <!--  Search Bar  -->

            <SearchBar
                BackgroundColor="#1E1E1E"
                Placeholder="Search songs or artists..."
                PlaceholderColor="#888888"
                SearchCommand="{Binding SearchCommand}"
                Text="{Binding SearchText}"
                TextColor="White" />

            <!--  Recent Searches  -->

            <Label
                FontAttributes="Bold"
                FontSize="22"
                Text="Recent Searches"
                TextColor="White" />

            <CollectionView ItemsSource="{Binding RecentSearches}" SelectionMode="None">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="0,0,0,10"
                            Padding="15"
                            BackgroundColor="#1E1E1E"
                            StrokeShape="RoundRectangle 15"
                            StrokeThickness="0">

                            <Label
                                FontSize="16"
                                Text="{Binding .}"
                                TextColor="White" />

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <!--  Songs  -->

            <Label
                FontAttributes="Bold"
                FontSize="22"
                Text="Popular Songs"
                TextColor="White" />

            <CollectionView ItemsSource="{Binding FilteredSongs}" SelectionMode="None">

                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        Padding="30"
                        HorizontalOptions="Center"
                        Spacing="10">

                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            HorizontalTextAlignment="Center"
                            Text="No songs found"
                            TextColor="White" />

                        <Label
                            FontSize="14"
                            HorizontalTextAlignment="Center"
                            Text="Try searching with a different title or artist."
                            TextColor="#AAAAAA" />

                    </VerticalStackLayout>

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="0,0,0,12"
                            Padding="12"
                            BackgroundColor="#1E1E1E"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="0">

                            <Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="15">

                                <Image
                                    Aspect="AspectFill"
                                    HeightRequest="60"
                                    Source="{Binding Image}"
                                    WidthRequest="60" />

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        Text="{Binding Title}"
                                        TextColor="White" />

                                    <Label
                                        FontSize="14"
                                        Text="{Binding Artist}"
                                        TextColor="#AAAAAA" />

                                </VerticalStackLayout>

                                <Image
                                    Grid.Column="2"
                                    HeightRequest="22"
                                    Source="play.png"
                                    VerticalOptions="Center"
                                    WidthRequest="22" />

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>